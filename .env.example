# Interview OS — AI Gateway Environment Configuration
# Copy this file to .env.local to enable live LLM evaluation:
# cp .env.example .env.local

# Vercel AI Gateway / OpenAI API Key
AI_GATEWAY_API_KEY=your_key_here

# Optional: custom gateway URL (defaults to https://api.openai.com/v1/chat/completions)
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/...

# Optional: model override (defaults to gpt-4o-mini)
# AI_MODEL=gpt-4o-mini
